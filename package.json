{
  "name": "okx-ai-trading-system",
  "version": "1.0.0",
  "description": "AI-powered autonomous trading system for OKX exchange, inspired by nof1.ai Alpha Arena",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "okx",
    "trading",
    "ai",
    "crypto",
    "automated-trading",
    "llm",
    "alpha-arena"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "okx-api": "^5.0.0",
    "dotenv": "^16.4.5",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "anthropic": "^0.27.0",
    "openai": "^4.68.0",
    "ioredis": "^5.3.2",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/better-sqlite3": "^7.6.8",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
