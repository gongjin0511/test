# OKX AI Trading System - Python Edition Configuration

# OKX API Configuration
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here
OKX_API_ENV=demo  # demo or production

# AI Model Configuration
AI_PROVIDER=anthropic  # anthropic, openai, or custom
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
AI_MODEL=claude-sonnet-4.5  # or gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000

# Trading Configuration
INITIAL_CAPITAL=10000
TRADING_MODE=testnet  # testnet or live
DECISION_INTERVAL_MS=180000  # 3 minutes
TRADING_PAIRS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP,BNB-USDT-SWAP

# Risk Management
MAX_LEVERAGE=5
MAX_POSITION_SIZE_PERCENTAGE=20
STOP_LOSS_PERCENTAGE=5
TAKE_PROFIT_PERCENTAGE=10
MAX_CONCURRENT_POSITIONS=3
ENABLE_SHORT_SELLING=true
MAX_DAILY_LOSS_PERCENT=10
MAX_DRAWDOWN_PERCENT=20
MAX_PORTFOLIO_EXPOSURE_PERCENT=80
REQUIRE_STOP_LOSS=true
MIN_CONFIDENCE_THRESHOLD=0.6
CIRCUIT_BREAKER_ENABLED=true

# Database
DB_PATH=./data/trading.db

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FILE=./logs/trading.log

# Redis (Optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
