# OKX API Configuration
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here
OKX_API_ENV=demo  # demo or production

# AI Model Configuration
AI_PROVIDER=anthropic  # anthropic, openai, or custom
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# AI Model Selection
AI_MODEL=claude-sonnet-4.5  # or gpt-4o, etc.

# Trading Configuration
INITIAL_CAPITAL=10000
TRADING_MODE=testnet  # testnet or live
DECISION_INTERVAL_MS=180000  # 3 minutes (180000ms)

# Trading Pairs (comma-separated)
TRADING_PAIRS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP,BNB-USDT-SWAP

# Risk Management
MAX_LEVERAGE=5
MAX_POSITION_SIZE_PERCENTAGE=20  # Max 20% of capital per position
STOP_LOSS_PERCENTAGE=5
TAKE_PROFIT_PERCENTAGE=10

# Database
DB_PATH=./data/trading.db

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FILE=./logs/trading.log

# Redis (for distributed systems - optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Monitoring & Alerts
ENABLE_PERFORMANCE_TRACKING=true
ALERT_ON_LARGE_LOSS=true
LARGE_LOSS_THRESHOLD_PERCENTAGE=10
